{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scrald",
        "width": 1000,
        "height": 800,
        "minWidth": 360,
        "minHeight": 300,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "fileAssociations": [
      {
        "name": "Markdown document",
        "ext": ["md", "markdown"],
        "contentTypes": ["net.daringfireball.markdown"],
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "name": "Markdown document (.mdown)",
        "ext": ["mdown"],
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
