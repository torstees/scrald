{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "appimage"],
    "longDescription": "Scrald is a themeable Markdown reader with light editing, for anything from technical notes and Obsidian vaults to full-length novels.",
    "fileAssociations": [
      {
        "name": "Markdown document",
        "ext": ["md", "markdown", "mdown"],
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/scrald.desktop",
        "files": {
          "/usr/share/mime/packages/scrald.xml": "linux/scrald-mime.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/mime/packages/scrald.xml": "linux/scrald-mime.xml"
        }
      }
    }
  }
}
