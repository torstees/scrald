# LF line endings everywhere, in the repo and in the working tree,
# regardless of each machine's core.autocrlf setting.
* text=auto eol=lf

# Test fixtures are stored byte-for-byte. Some deliberately use CRLF or a
# UTF-8 BOM to test that Scrald preserves them, so git must never convert them.
crates/scrald-core/tests/fixtures/** -text

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
